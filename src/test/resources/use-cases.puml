@startuml
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8F8F8
  BorderColor Black
}

actor "Пользователь" as User

rectangle "Азбука знакомств" {
    useCase "Аутентификация" as UC1
    useCase "Изучение анкеты" as UC2
    useCase "Редактирование профиля" as UC3
    useCase "Просмотр профиля" as UC4
    useCase "Поиск анкет" as UC5_1
    useCase "Фильтрация анкет" as UC5_2
}

User --> UC1
User --> UC2
User --> UC3
User -> UC5_1

UC3 ..> UC4 : <<include>>
UC5_1 <.. UC5_2 : <<extends>>
@enduml